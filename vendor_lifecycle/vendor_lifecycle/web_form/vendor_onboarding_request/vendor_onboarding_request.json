 "button_label": "Submit",
 "client_script": "frappe.web_form.on(\"establishment_date\", (field, value) => {\n\tif (!value) return;\n\tconst days = frappe.datetime.get_day_diff(frappe.datetime.now_date(), value);\n\tif (days < 0) {\n\t\tfrappe.msgprint(__(\"Establishment Date cannot be in the future.\"));\n\t\tfrappe.web_form.set_value(\"establishment_date\", \"\");\n\t\treturn;\n\t}\n\tconst years = days / 365.25;\n\tfrappe.web_form.set_value(\"years_in_business\", Math.max(0, Math.round(years * 100) / 100));\n});\n\n// Web Forms turn every Link field into a static Autocomplete at render\n// time, pre-loaded with EVERY record of the target doctype (frappe's own\n// process_link_field()/get_link_options() \u2014 there's no live, server-side,\n// country-scoped query on a web form, unlike the desk forms). So filtering\n// by Country happens client-side instead, against the already-loaded full\n// list, via the Autocomplete control's own set_data().\nfrappe.web_form.on(\"country\", (field, value) => {\n\tfrappe.web_form.set_value(\"state_master\", \"\");\n\tconst state_field = frappe.web_form.get_field(\"state_master\");\n\tif (!state_field) return;\n\n\tif (!frappe.web_form._all_states) {\n\t\tfrappe.web_form._all_states = (state_field.df.options || \"\").split(\"\\n\").filter(Boolean);\n\t}\n\tconst filtered = value ? frappe.web_form._all_states.filter((s) => s.endsWith(`(${value})`)) : [];\n\tstate_field.set_data(filtered);\n\n\tif (value && !filtered.length) {\n\t\tfrappe.msgprint({\n\t\t\ttitle: __(\"No States Listed Yet\"),\n\t\t\tindicator: \"orange\",\n\t\t\tmessage: __(\"No states are listed yet for {0}.\", [frappe.bold(value)]),\n\t\t});\n\t}\n});\n\nfrappe.web_form.on(\"state_master\", (field, value) => {\n\tif (!value) return;\n\tfrappe.db.get_value(\"State\", value, \"state_name\").then((r) => {\n\t\tif (r.message && r.message.state_name) {\n\t\t\tfrappe.web_form.set_value(\"state\", r.message.state_name);\n\t\t}\n\t});\n});\n",
